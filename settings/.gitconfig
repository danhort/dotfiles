# include local gticonfig
[include]
path = "~/.dotfiles/local/.gitconfig"
[core]
	pager = less
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
